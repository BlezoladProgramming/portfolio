# Set to the domain actually used by this deployment (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://portfolio-nine-pi-48.vercel.app
# Only configure after verifying your sender domain with Resend.
# Without these variables, visitors will see working direct email/WhatsApp links instead of a fake form.
CONTACT_FORM_ENABLED=false
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
